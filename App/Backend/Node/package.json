{
  "name": "ch2026-backend-api",
  "version": "2.0.0",
  "description": "Backend API para Sistema de Gestión de Cálculo de Honorarios CPAU - AWS Lambda + Node.js + MySQL",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon index.js",
    "start": "node index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "deploy:dev": "serverless deploy --stage dev",
    "deploy:qa": "serverless deploy --stage qa",
    "logs:dev": "serverless logs -f api --tail --stage dev",
    "logs:qa": "serverless logs -f api --tail --stage qa",
    "invoke:local": "serverless invoke local -f api"
  },
  "keywords": [
    "cpau",
    "honorarios",
    "backend",
    "lambda",
    "serverless",
    "mysql"
  ],
  "author": "Neosis - Carlos Sánchez",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "mysql2": "^3.6.0",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "aws-sdk": "^2.1400.0",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.6.1",
    "supertest": "^6.3.3",
    "serverless": "^3.35.0",
    "serverless-offline": "^13.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
