{
	"info": {
		"_postman_id": "spec029-tyc-tests",
		"name": "SPEC029 - Términos y Condiciones - Tests",
		"description": "Colección de pruebas para endpoints de Términos y Condiciones\n\nSPEC: SPEC029-CALC-Términos y condiciones\nTICKET: T029-014\nFecha: 2026-08-06",
