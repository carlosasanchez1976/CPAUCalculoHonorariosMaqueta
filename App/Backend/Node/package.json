{
  "name": "cpau-ch-api",
  "version": "1.0.0",
  "description": "API REST para sistema de Cálculo de Honorarios CPAU",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "package": "node create-deployment-package.js",
    "upload:qa": "aws lambda update-function-code --function-name cpau-ch2026-api-qa --zip-file fileb://ch2026-backend-api-lambda.zip",
    "upload:prod": "aws lambda update-function-code --function-name cpau-ch2026-api-prod --zip-file fileb://ch2026-backend-api-lambda.zip",
    "test:rds": "node test-rds.js",
    "test:cors": "node test-cors.js",
    "deploy:dev": "serverless deploy --stage dev",
    "deploy:qa": "serverless deploy --stage qa",
    "deploy:prod": "serverless deploy --stage prod",
    "deploy:function": "serverless deploy function -f api",
    "logs": "serverless logs -f api --tail",
    "info": "serverless info",
    "remove": "serverless remove"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@aws-sdk/client-sesv2": "^3.700.0",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.16.0",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "axios": "^1.13.2",
    "nodemon": "^3.1.11",
    "serverless": "^3.38.0",
    "serverless-offline": "^13.8.1"
  }
}
