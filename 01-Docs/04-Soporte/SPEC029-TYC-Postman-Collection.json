	"item": [
		{
			"name": "01. PÚBLICO - Obtener TyC Vigente",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Respuesta tiene tyc_id\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('tyc_id');",
							"});",
							"",
							"pm.test(\"Campo vigente es true\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.vigente).to.eql(true);",
							"});",
							"",
							"pm.test(\"Versión es 1.0\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.version).to.eql('1.0');",
							"});",
							"",
							"pm.test(\"Contenido Markdown presente\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.contenido_md).to.include('Términos y Condiciones');",
							"    pm.expect(jsonData.contenido_md.length).to.be.above(10000);",
							"});",
							"",
							"// Guardar tyc_id para usar en otras pruebas",
							"pm.environment.set(\"tyc_id_vigente\", pm.response.json().tyc_id);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/terminos-condiciones/vigente",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"terminos-condiciones",
						"vigente"
					]
				},
				"description": "Endpoint público para obtener TyC vigente.\n\n✅ No requiere autenticación\n✅ Debe devolver el TyC con vigente=true"
			},
			"response": []
		},
		{
			"name": "02. LOGIN - Obtener Token ADMIN",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Respuesta tiene token\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('token');",
							"});",
							"",
							"pm.test(\"Usuario es ADMIN\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.user.rol).to.eql('ADMIN');",
							"});",
							"",
							"// Guardar token y user_id para usar en otras pruebas",
							"pm.environment.set(\"admin_token\", pm.response.json().token);",
							"pm.environment.set(\"admin_user_id\", pm.response.json().user.user_id);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/usuarios/login",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"usuarios",
						"login"
					]
				},
				"description": "Login como usuario ADMIN para obtener token JWT.\n\n⚠️ Configurar email y password en Environment"
			},
			"response": []
		},
