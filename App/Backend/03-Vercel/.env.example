# ============================================================================
# VARIABLES DE ENTORNO - VERCEL FUNCTIONS (QA/STAGING)
# ============================================================================
# IMPORTANTE: Estas variables se configuran en Vercel Dashboard
# Settings > Environment Variables
#
# NO usar archivo .env en Vercel (no se sube al deploy)
# ============================================================================

# Ambiente
NODE_ENV=production

# API Version
API_VERSION=v1

# CORS Origins (separados por coma)
# Ejemplo: https://ch2026-frontend.vercel.app,https://qa.cpau-honorarios.com
CORS_ORIGIN=https://tu-frontend.vercel.app

# ============================================================================
# INSTRUCCIONES DE CONFIGURACIÓN
# ============================================================================
# 1. Ir a Vercel Dashboard > Tu Proyecto > Settings > Environment Variables
# 2. Agregar cada variable arriba con sus valores para QA/Production
# 3. Seleccionar en qué ambientes aplica (Production, Preview, Development)
# 4. Hacer redeploy después de cambiar variables
