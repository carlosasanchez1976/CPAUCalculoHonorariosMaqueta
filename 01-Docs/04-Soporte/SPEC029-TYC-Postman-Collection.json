			"name": "04. ADMIN - Listar Histórico TyC",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Respuesta es array\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an('array');",
							"});",
							"",
							"pm.test(\"Hay al menos 1 TyC\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.length).to.be.above(0);",
							"});",
							"",
							"pm.test(\"Contenido truncado a 200 chars\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData[0].contenido_md.length).to.be.at.most(203); // 200 + '...'",
							"});"
